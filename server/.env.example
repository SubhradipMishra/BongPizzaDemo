# ──────────────────────────────────────────────────
# BongPizza Server – Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────

# Port the Express server listens on (default 7070)
PORT=7070

# Your deployed frontend URL (Render static site URL)
# Example: https://bongpizza.onrender.com
# For local dev: http://localhost:5173
FRONTEND_URL=https://YOUR_RENDER_STATIC_SITE_URL.onrender.com

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# For local dev: mongodb://localhost:27017/bongPizza
DB_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/bongPizza?retryWrites=true&w=majority

# Strong random secret for JWT signing (keep this private!)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Automated Daily Backup Cron Schedule (UTC)
# Default: 29 18 * * * (which is 23:59 IST, shop closing time)
BACKUP_CRON_SCHEDULE="29 18 * * *"

