# Base URL of your Express API server
# For local dev: http://localhost:7070/api
# For production (VPS): http://YOUR_VPS_IP:7070/api
#   OR if you have a domain: https://api.yourdomain.com/api
VITE_API_BASE_URL=http://YOUR_VPS_IP:7070/api
